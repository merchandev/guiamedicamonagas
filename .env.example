# --- ENTORNO ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- BASE DE DATOS ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=guia_medica
# Para desarrollo local (fuera de Docker):
DATABASE_URL="postgresql://postgres:password@localhost:5432/guia_medica?schema=public"
# Para producción en Docker:
# DATABASE_URL="postgresql://postgres:password@postgres:5432/guia_medica?schema=public"

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MEILISEARCH ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_123

# --- ALMACENAMIENTO (MinIO/S3) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecret123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=guiamedica
S3_ACCESS_KEY=admin
S3_SECRET_KEY=supersecret123

# --- AUTENTICACIÓN ---
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me
JWT_REFRESH_EXPIRATION=7d

# --- CORREO ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Guía Médica Monagas <no-reply@guiamedicamonagas.com>"
