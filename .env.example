# --- ENTORNO ---
NODE_ENV=development
PORT=4000
# Desarrollo local (frontend y backend corriendo por separado, npm run dev):
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Producción con Docker + Caddy (mismo dominio sirve /api/* y el resto vía reverse proxy):
# FRONTEND_URL=https://guiamedicamonagas.com
# NEXT_PUBLIC_API_URL=https://guiamedicamonagas.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://guiamedicamonagas.com

# --- BASE DE DATOS ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=guia_medica
# Para desarrollo local (fuera de Docker):
DATABASE_URL="postgresql://postgres:password@localhost:5432/guia_medica?schema=public"
# Para producción en Docker:
# DATABASE_URL="postgresql://postgres:password@postgres:5432/guia_medica?schema=public"

# --- REDIS (opcional, reservado para trabajos en segundo plano) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MEILISEARCH (opcional, reservado para búsqueda avanzada) ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_123

# --- ALMACENAMIENTO PRIVADO (MinIO/S3) — documentos y comprobantes de pago ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecret123
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=guiamedica
S3_ACCESS_KEY=admin
S3_SECRET_KEY=supersecret123
S3_FORCE_PATH_STYLE=true

# --- AUTENTICACIÓN ---
JWT_SECRET=change_me_min_32_chars_super_secret_jwt_key
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change_me_min_32_chars_super_secret_refresh_key
JWT_REFRESH_EXPIRATION_DAYS=7
COOKIE_SECRET=change_me_min_32_chars_cookie_secret_key

# --- CORREO (en desarrollo usa Mailpit: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Guía Médica Monagas <no-reply@guiamedicamonagas.com>"

# --- WHATSAPP (Meta WhatsApp Cloud API) ---
# Requiere una app de Meta Business con WhatsApp Cloud API configurada.
# Mientras WHATSAPP_ENABLED=false, los envíos solo quedan registrados (no se envían).
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# --- CUENTA DE PAGO MÓVIL DE LA PLATAFORMA (a donde pagan los profesionales) ---
PAGO_MOVIL_BANK_NAME=Banesco
PAGO_MOVIL_BANK_CODE=0134
PAGO_MOVIL_PHONE=0414-0000000
PAGO_MOVIL_ID=J-000000000
