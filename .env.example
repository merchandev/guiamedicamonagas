# =============================================================================
# .env.example  ·  Plantilla de variables de entorno
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo a .env.prod (producción) o .env (desarrollo).
#   2. Rellena TODOS los valores. NUNCA dejes los ejemplos en producción.
#   3. Genera secrets seguros con: openssl rand -base64 48
#   4. Asegúrate de que .env.prod y .env están en .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# ENTORNO
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# URL del frontend (para CORS en el backend)
FRONTEND_URL=http://localhost:3000

# URLs públicas del frontend (para el build de Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Producción con Caddy (mismo dominio):
# FRONTEND_URL=https://guiamedicamonagas.com
# NEXT_PUBLIC_API_URL=https://guiamedicamonagas.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://guiamedicamonagas.com

# ---------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ---------------------------------------------------------------------------
DB_USER=gmm_dev
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 32`
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_NAME=guia_medica_dev

# Para desarrollo local (fuera de Docker):
DATABASE_URL="postgresql://gmm_dev:CHANGE_ME_IN_PRODUCTION@localhost:5432/guia_medica_dev?schema=public"
# Para producción en Docker (la DATABASE_URL la construye docker-compose.prod.yml automáticamente):
# DATABASE_URL se configura via docker-compose.prod.yml, no necesita estar aquí en prod.

# ---------------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# ⚠️ PRODUCCIÓN: requerido, genera con `openssl rand -base64 32`
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ---------------------------------------------------------------------------
# MEILISEARCH
# ---------------------------------------------------------------------------
MEILI_HOST=http://localhost:7700
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 48`
MEILI_MASTER_KEY=CHANGE_ME_IN_PRODUCTION

# ---------------------------------------------------------------------------
# ALMACENAMIENTO PRIVADO (MinIO / S3)
# ---------------------------------------------------------------------------
# Credenciales ROOT de MinIO — solo para la inicialización inicial con
# scripts/minio-init.sh. La API NUNCA debe usar estas credenciales.
MINIO_ROOT_USER=gmm_minio_root
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 32`
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Credenciales del USUARIO DE SERVICIO (creado por minio-init.sh)
# Estas son las que usa la API.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=guiamedica
# ⚠️ PRODUCCIÓN: usuario de servicio con permisos limitados (ver minio-init.sh)
S3_ACCESS_KEY=gmm_app_user
S3_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# AUTENTICACIÓN
# ---------------------------------------------------------------------------
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 48` (mínimo 32 chars)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_IN_PRODUCTION
JWT_EXPIRATION=15m

# ⚠️ PRODUCCIÓN: diferente a JWT_SECRET, genera con `openssl rand -base64 48`
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_DIFFERENT_FROM_JWT_SECRET
JWT_REFRESH_EXPIRATION_DAYS=7

# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 48`
COOKIE_SECRET=CHANGE_ME_MIN_32_CHARS_IN_PRODUCTION

# ---------------------------------------------------------------------------
# CORREO (en desarrollo usa Mailpit: http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Guía Médica Monagas <no-reply@guiamedicamonagas.com>"

# ---------------------------------------------------------------------------
# WHATSAPP (Meta WhatsApp Cloud API)
# ---------------------------------------------------------------------------
# Mientras WHATSAPP_ENABLED=false, los envíos solo se registran localmente.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# ---------------------------------------------------------------------------
# PAGO MÓVIL — cuenta de la plataforma (a donde pagan los profesionales)
# ---------------------------------------------------------------------------
PAGO_MOVIL_BANK_NAME=Banesco
PAGO_MOVIL_BANK_CODE=0134
PAGO_MOVIL_PHONE=0414-0000000
PAGO_MOVIL_ID=J-000000000
