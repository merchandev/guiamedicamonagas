# =============================================================================
# .env.example  ·  Plantilla de variables de entorno
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo a .env.prod (producción) o .env (desarrollo).
#   2. Rellena TODOS los valores. NUNCA dejes los ejemplos en producción.
#   3. Genera secrets seguros con: openssl rand -base64 48
#   4. Asegúrate de que .env.prod y .env están en .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# ENTORNO
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# URL del frontend (para CORS en el backend)
FRONTEND_URL=http://localhost:3000

# URLs públicas del frontend (para el build de Next.js) — las ve el navegador.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API_INTERNAL_URL (opcional): usada SOLO por el servidor Next.js en runtime
# dentro de Docker para sus propios fetches (SSR) — nunca llega al navegador.
# Sin esto, el contenedor `web` intentaría usar NEXT_PUBLIC_API_URL para
# hablar consigo mismo, lo cual no resuelve dentro de la red de Docker.
# API_INTERNAL_URL=http://api:4000/api/v1

# Producción con Caddy en un puerto alterno (sin dominio propio todavía,
# ej. conviviendo con otros proyectos en el mismo VPS/IP — ver Caddyfile).
# El puerto se publica solo en 127.0.0.1 salvo CADDY_BIND_ADDRESS=0.0.0.0
# (acceso directo por IP en HTTP: NO-GO para pacientes reales).
# CADDY_PORT=8088
# CADDY_BIND_ADDRESS=0.0.0.0
# FRONTEND_URL=http://TU_IP_PUBLICA:8088
# NEXT_PUBLIC_API_URL=http://TU_IP_PUBLICA:8088/api/v1
# NEXT_PUBLIC_SITE_URL=http://TU_IP_PUBLICA:8088
# API_INTERNAL_URL=http://api:4000/api/v1
# COOKIE_SECURE=false   # el navegador nunca reenvía una cookie "secure" por HTTP sin cifrar

# Producción con dominio propio y HTTPS. El Traefik del VPS (dueño de 80/443)
# enruta el dominio a Caddy :8088 y emite el certificado de Let's Encrypt; el
# DNS (A de @ y www → IP del VPS) debe resolver antes de activarlo:
# GMM_DOMAIN=guiamedicamonagas.com
# GMM_TRAEFIK_ENABLE=true
# Y, una vez que el dominio responda por HTTPS, cambiar las URL públicas
# (NEXT_PUBLIC_* exige reconstruir la imagen web):
# FRONTEND_URL=https://guiamedicamonagas.com
# NEXT_PUBLIC_API_URL=https://guiamedicamonagas.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://guiamedicamonagas.com
# S3_PUBLIC_ENDPOINT=https://guiamedicamonagas.com
# API_INTERNAL_URL=http://api:4000/api/v1
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ---------------------------------------------------------------------------
DB_USER=gmm_dev
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 32`
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_NAME=guia_medica_dev

# Para desarrollo local (fuera de Docker):
DATABASE_URL="postgresql://gmm_dev:CHANGE_ME_IN_PRODUCTION@localhost:5432/guia_medica_dev?schema=public"
# Para producción en Docker (la DATABASE_URL la construye docker-compose.prod.yml automáticamente):
# DATABASE_URL se configura via docker-compose.prod.yml, no necesita estar aquí en prod.

# ---------------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# ⚠️ PRODUCCIÓN: requerido, genera con `openssl rand -base64 32`
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ---------------------------------------------------------------------------
# MEILISEARCH
# ---------------------------------------------------------------------------
MEILI_HOST=http://localhost:7700
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 48`
MEILI_MASTER_KEY=CHANGE_ME_IN_PRODUCTION

# ---------------------------------------------------------------------------
# ALMACENAMIENTO PRIVADO (MinIO / S3)
# ---------------------------------------------------------------------------
# Credenciales ROOT de MinIO — solo para la inicialización inicial con
# scripts/minio-init.sh. La API NUNCA debe usar estas credenciales.
MINIO_ROOT_USER=gmm_minio_root
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 32`
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Credenciales del USUARIO DE SERVICIO (creado por minio-init.sh)
# Estas son las que usa la API.
S3_ENDPOINT=http://localhost:9000
# URL pública (proxeada por Caddy) usada SOLO para firmar las URLs de
# descarga que abre el navegador (fotos, documentos). MinIO en sí nunca se
# expone directamente. Sin dominio propio, usa la IP:puerto + nombre del
# bucket como ruta (ver Caddyfile): http://TU_IP_PUBLICA:8088/guiamedica
# S3_PUBLIC_ENDPOINT=http://TU_IP_PUBLICA:8088
S3_REGION=us-east-1
S3_BUCKET=guiamedica
# ⚠️ PRODUCCIÓN: usuario de servicio con permisos limitados (ver minio-init.sh)
S3_ACCESS_KEY=gmm_app_user
S3_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# AUTENTICACIÓN
# ---------------------------------------------------------------------------
# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 48` (mínimo 32 chars)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_IN_PRODUCTION
JWT_EXPIRATION=15m

# ⚠️ PRODUCCIÓN: diferente a JWT_SECRET, genera con `openssl rand -base64 48`
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_DIFFERENT_FROM_JWT_SECRET
JWT_REFRESH_EXPIRATION_DAYS=7

# ⚠️ PRODUCCIÓN: genera con `openssl rand -base64 48`
COOKIE_SECRET=CHANGE_ME_MIN_32_CHARS_IN_PRODUCTION

# Cookie del refresh token marcada "secure" (solo se envía por HTTPS).
# ⚠️ Ponla en `false` SOLO durante un lanzamiento temporal por HTTP simple
# (ver bloque de Caddy con puerto alterno más arriba) — nunca en un sitio
# con HTTPS real, donde debe quedar en `true`.
COOKIE_SECURE=true

# Usuario SUPERADMIN sembrado por `prisma db seed` / `prisma migrate deploy`.
# ⚠️ PRODUCCIÓN: SEED_SUPERADMIN_PASSWORD es OBLIGATORIA — el seed aborta con
# error si falta (antes se omitía el superadmin en silencio). Genera una
# contraseña real, no la dejes vacía ni con un valor de ejemplo.
SEED_SUPERADMIN_EMAIL=admin@guiamedicamonagas.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ---------------------------------------------------------------------------
# CIFRADO DE DATOS DE PACIENTES (SEC-05)
# ---------------------------------------------------------------------------
# Llavero AES-256-GCM: "id:base64" separados por coma. Cada clave = 32 bytes:
#   echo "v1:$(openssl rand -base64 32)"
# Para rotar: agrega v2 al llavero, pon DATA_ENCRYPTION_ACTIVE_KEY=v2 y conserva
# v1 mientras existan datos cifrados con ella.
# ⚠️ Respáldalas FUERA del servidor y lejos de los respaldos de la base de
# datos: si se pierden, los datos cifrados no se pueden recuperar.
DATA_ENCRYPTION_KEYS=v1:CHANGE_ME_BASE64_32_BYTES
DATA_ENCRYPTION_ACTIVE_KEY=v1
# Clave HMAC distinta para búsquedas exactas (cédula/teléfono): openssl rand -base64 32
DATA_LOOKUP_KEY=CHANGE_ME_BASE64_32_BYTES

# Código por correo como segundo factor para ADMIN/SUPERADMIN. OBLIGATORIO en
# producción (la API no arranca sin él) y requiere un SMTP real: con Mailpit el
# código nunca llegaría al buzón. Única excepción, temporal y fechada, mientras
# se configura el SMTP (deploy.sh la rechaza al vencer):
# ADMIN_MFA_WAIVER_UNTIL=AAAA-MM-DD
ADMIN_MFA_ENABLED=false

# Antivirus de subidas (clamd). OBLIGATORIO en producción: el servicio
# `clamav` de docker-compose.prod.yml siempre se levanta y CLAMAV_HOST=clamav
# hace que la API lo use. Vacío solo en desarrollo y pruebas.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Respaldos (scripts/backup.sh, cron en el VPS): frase de cifrado fuera del
# repo y copia externa por rsync (regla 3-2-1). Ver docs/operations/respaldos-y-restauracion.md.
# GMM_BACKUP_PASSPHRASE_FILE=/root/.config/guiamedicamonagas/backup-passphrase
# GMM_BACKUP_REMOTE=usuario@host:/ruta

# ---------------------------------------------------------------------------
# CORREO (en desarrollo usa Mailpit: http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Guía Médica Monagas <no-reply@guiamedicamonagas.com>"

# En docker-compose.prod.yml se levanta un Mailpit propio del proyecto
# (servicio `mailpit`, sin publicar puertos salvo la interfaz web en
# 127.0.0.1:18025) mientras no haya SMTP real configurado. NO entrega
# correo a destinatarios externos — solo lo captura para pruebas.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# WHATSAPP (Meta WhatsApp Cloud API)
# ---------------------------------------------------------------------------
# Mientras WHATSAPP_ENABLED=false, los envíos solo se registran localmente.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# ---------------------------------------------------------------------------
# PAGO MÓVIL — cuenta de la plataforma (a donde pagan los profesionales)
# ---------------------------------------------------------------------------
PAGO_MOVIL_BANK_NAME=Banesco
PAGO_MOVIL_BANK_CODE=0134
PAGO_MOVIL_PHONE=0414-0000000
PAGO_MOVIL_ID=J-000000000
