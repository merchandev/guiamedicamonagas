# =============================================================================
# Caddyfile · Lanzamiento HTTP independiente (sin dominio/HTTPS todavía)
# =============================================================================
# Este proyecto corre aislado junto a otros servicios en el mismo VPS/IP, cuyos
# puertos 80/443/3000/25/587 ya están ocupados. Por eso Caddy escucha en un
# puerto alterno (8088) sin bloque ACME/TLS: es HTTP simple a propósito. La
# migración a HTTPS con dominio propio (segunda IP, DNS-01 challenge o
# certificado manual) es un paso posterior que no debería requerir tocar la
# app — solo este archivo y el mapeo de puertos en docker-compose.prod.yml.
# =============================================================================

:8088 {
	# Headers de seguridad que sí aplican sin HTTPS (HSTS se omite a propósito:
	# forzarlo sobre una conexión sin cifrar rompería el propio sitio).
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API — solo /api/* llega al backend NestJS
	handle /api/* {
		reverse_proxy api:4000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Archivos de MinIO (fotos de perfil, documentos con URL firmada) — el
	# nombre del bucket es el propio prefijo de ruta, así que no hace falta
	# reescribir el path y la firma SigV4 de la URL (generada por la API
	# contra S3_PUBLIC_ENDPOINT) sigue siendo válida: Caddy conserva el
	# header Host original por defecto, que es lo que la firma cubre.
	handle /{$S3_BUCKET}/* {
		reverse_proxy minio:9000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Todo lo demás va al frontend Next.js
	handle /* {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Logs de acceso estructurados
	log {
		output stdout
		format json
	}
}
