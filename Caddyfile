# =============================================================================
# Caddyfile · proxy interno del proyecto (HTTP en :8088)
# =============================================================================
# Este proyecto comparte VPS/IP con otros servicios; los puertos 80/443 son del
# Traefik del servidor (proyecto traefik-ivzc), que termina HTTPS con Let's
# Encrypt para cada dominio. El dominio propio (GMM_DOMAIN) llega así:
#
#   navegador ─HTTPS─▶ Traefik :443 ─HTTP─▶ este Caddy :8088 ─▶ web / api / minio
#
# Traefik encuentra este Caddy por las etiquetas del servicio `caddy` en
# docker-compose.prod.yml (sin tocar la configuración de Traefik). Por eso aquí
# no hay bloque TLS; el puerto :8088 del host queda solo en 127.0.0.1.
# =============================================================================
{
	servers {
		# Traefik usa la red del host y llega a este contenedor desde la puerta
		# de enlace de gmm_dmz. Solo de esa dirección se aceptan los
		# X-Forwarded-*: así la API ve la IP real del visitante (límites de
		# peticiones por IP) sin que un cliente pueda inventarla.
		trusted_proxies static 172.31.78.1/32
	}
}

:8088 {
	# Headers de seguridad. HSTS lo agrega Traefik (etiquetas de `caddy` en
	# docker-compose.prod.yml), que es el único camino con HTTPS.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API — solo /api/* llega al backend NestJS
	handle /api/* {
		reverse_proxy api:4000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Archivos de MinIO (fotos de perfil, documentos con URL firmada) — el
	# nombre del bucket es el propio prefijo de ruta, así que no hace falta
	# reescribir el path y la firma SigV4 de la URL (generada por la API
	# contra S3_PUBLIC_ENDPOINT) sigue siendo válida: Caddy conserva el
	# header Host original por defecto, que es lo que la firma cubre.
	handle /{$S3_BUCKET}/* {
		reverse_proxy minio:9000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Todo lo demás va al frontend Next.js
	handle /* {
		reverse_proxy web:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Logs de acceso estructurados
	log {
		output stdout
		format json
	}
}
