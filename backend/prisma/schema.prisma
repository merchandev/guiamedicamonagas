// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cuentas y autenticación
// ---------------------------------------------------------------------------

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  role                  Role                   @default(USER)
  isEmailVerified       Boolean                @default(false)
  isActive              Boolean                @default(true)
  failedLoginAttempts   Int                    @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  professionalProfile   ProfessionalProfile?
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  reviewedDocuments      ProfessionalDocument[] @relation("DocumentReviewer")
  reviewedPayments      Payment[]              @relation("PaymentReviewer")

  @@index([role])
}

enum Role {
  USER
  PROFESSIONAL
  ADMIN
  SUPERADMIN
}

model RefreshToken {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String                 @unique
  userAgent            String?
  ipAddress            String?
  expiresAt            DateTime
  revokedAt            DateTime?
  replacedByTokenHash  String?
  createdAt            DateTime               @default(now())

  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String                 @unique
  type                 VerificationTokenType
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime               @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Perfil profesional y verificación legal (Ley de Ejercicio de la Medicina,
// MPPS/SACS, Colegio de Médicos de Monagas, INPREMEDICO)
// ---------------------------------------------------------------------------

model ProfessionalProfile {
  id                   String                 @id @default(uuid())
  userId               String                 @unique
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug                 String                 @unique
  firstName            String
  lastName             String
  photoUrl             String?
  bio                  String?

  // Avales legales y gremiales (obligatorios para publicarse en el directorio)
  mppsNumber           String?
  colmedMonagasNumber  String?
  inpremedicoNumber    String?
  cedula               String?
  rif                  String?

  verificationStatus   VerificationStatus     @default(PENDING)
  rejectionReason      String?
  verifiedAt           DateTime?
  isPublished          Boolean                @default(false)
  isSpecialist         Boolean                @default(false)
  planTier             PlanTier               @default(FREE)

  phone                String?
  whatsapp             String?
  website              String?
  municipality         String?
  address              String?
  latitude             Float?
  longitude            Float?

  seoTitle             String?
  seoDescription       String?
  seoKeywords          String?
  ogImageUrl           String?
  noIndex              Boolean                @default(false)

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  specialties          ProfessionalSpecialty[]
  documents            ProfessionalDocument[]
  subscriptions        Subscription[]
  posts                Post[]
  messages             ContactMessage[]
  locations            ProfessionalLocation[]

  @@index([verificationStatus, isPublished])
  @@index([municipality])
  @@index([planTier])
}

/** Sedes adicionales de consulta, disponibles desde el plan Profesional Plus. */
model ProfessionalLocation {
  id                   String                 @id @default(uuid())
  professionalId       String
  professional         ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  name                 String
  address              String
  municipality         String?
  phone                String?
  whatsapp             String?
  latitude             Float?
  longitude            Float?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

enum PlanTier {
  FREE
  PROFESSIONAL
  PROFESSIONAL_PLUS
  PREMIUM
  ORGANIZATION
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

// Catálogo de documentos exigidos por la ley venezolana para habilitar
// médicos en el directorio. Cada tipo tiene su propia validación de admin.
enum DocumentType {
  TITULO_MEDICO                // Título de Médico Cirujano (sellado Registro Principal)
  REGISTRO_MPPS_SACS           // Constancia de Registro de Título ante el MPPS (SACS)
  ARTICULO_8                   // Constancia de cumplimiento del Art. 8 (rural/internado)
  MATRICULA_COLEGIO_MONAGAS    // N° de Matrícula, Colegio de Médicos de Monagas
  INPREMEDICO                  // Registro ante la FMV
  SOLVENCIA_DEONTOLOGICA       // Vigencia anual, Colegio de Médicos de Monagas
  TITULO_POSTGRADO             // Solo especialistas
  CREDENCIAL_ESPECIALIDAD      // Reconocimiento de especialidad, Colegio de Médicos de Monagas
  CEDULA_IDENTIDAD
  RIF
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ProfessionalDocument {
  id                   String                 @id @default(uuid())
  professionalId       String
  professional         ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  type                 DocumentType
  fileKey              String                 // clave privada en almacenamiento (S3/MinIO)
  originalFileName     String
  mimeType             String
  fileSizeBytes        Int

  status               DocumentStatus         @default(PENDING)
  issuedAt             DateTime?              // fecha de emisión del documento (p.ej. solvencia)
  expiresAt            DateTime?              // solvencia deontológica vence anualmente

  reviewedById         String?
  reviewedBy           User?                  @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote           String?
  reviewedAt           DateTime?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([professionalId, type])
  @@index([status])
}

model Specialty {
  id                   String                 @id @default(uuid())
  slug                 String                 @unique
  name                 String                 @unique
  description          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  professionals        ProfessionalSpecialty[]
}

model ProfessionalSpecialty {
  professionalId       String
  specialtyId          String
  professional         ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty            Specialty              @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([professionalId, specialtyId])
}

// ---------------------------------------------------------------------------
// Organizaciones (farmacias, laboratorios, clínicas)
// ---------------------------------------------------------------------------

model Organization {
  id                   String                 @id @default(uuid())
  type                 OrganizationType
  slug                 String                 @unique
  name                 String
  description          String?
  logoUrl              String?
  website              String?
  isPublished          Boolean                @default(true)

  seoTitle             String?
  seoDescription        String?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  locations            OrganizationLocation[]
}

enum OrganizationType {
  PHARMACY
  LABORATORY
  CLINIC
}

model OrganizationLocation {
  id                   String                 @id @default(uuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                 String
  address              String
  municipality         String?
  phone                String?
  whatsapp             String?
  latitude             Float?
  longitude            Float?
  googlePlaceId        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

// ---------------------------------------------------------------------------
// Suscripciones y pagos (Pago Móvil, verificación manual por admin)
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                   String                 @id @default(uuid())
  tier                 PlanTier               @unique
  name                 String
  description          String?
  /** Precio de referencia en USD; el monto a pagar en Bs se calcula con la tasa vigente al momento de suscribirse. */
  priceUsd             Decimal                @db.Decimal(10, 2)
  billingCycle         BillingCycle
  /** Lista de beneficios a mostrar en la página de precios. */
  features             Json?
  /** Sedes totales permitidas (principal + adicionales). */
  maxLocations         Int                    @default(1)
  /** Publicaciones activas permitidas; null = ilimitadas. */
  postsLimit           Int?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  subscriptions        Subscription[]
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Subscription {
  id                   String                 @id @default(uuid())
  professionalId       String
  professional         ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  planId               String
  plan                 SubscriptionPlan       @relation(fields: [planId], references: [id])

  status               SubscriptionStatus     @default(PENDING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  installments         SubscriptionInstallment[]

  @@index([professionalId, status])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

model SubscriptionInstallment {
  id                   String                 @id @default(uuid())
  subscriptionId       String
  subscription         Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amountBs             Decimal                @db.Decimal(12, 2)
  dueDate              DateTime
  status               InstallmentStatus      @default(PENDING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  payments             Payment[]
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model Payment {
  id                   String                 @id @default(uuid())
  installmentId        String
  installment          SubscriptionInstallment @relation(fields: [installmentId], references: [id])

  amountBs             Decimal                @db.Decimal(12, 2)
  method               PaymentMethod          @default(PAGO_MOVIL)

  // Datos del reporte de Pago Móvil hechos por el profesional
  senderBankCode       String?
  senderBankName       String?
  senderPhone          String?
  referenceNumber      String?
  paidAt               DateTime?
  receiptFileKey       String?

  status               PaymentStatus          @default(PENDING)
  reviewedById         String?
  reviewedBy           User?                  @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote           String?
  reviewedAt           DateTime?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status])
  @@index([referenceNumber])
}

enum PaymentMethod {
  PAGO_MOVIL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REJECTED
}

// ---------------------------------------------------------------------------
// Contacto, notificaciones, analítica y publicidad
// ---------------------------------------------------------------------------

model ContactMessage {
  id                   String                 @id @default(uuid())
  professionalId       String
  professional         ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  senderName           String
  senderEmail          String
  senderPhone          String?
  content              String
  isRead               Boolean                @default(false)
  ipAddress            String?
  createdAt            DateTime               @default(now())
}

enum EventType {
  PROFILE_VIEW
  WHATSAPP_CLICK
  PHONE_CLICK
  WEBSITE_CLICK
  MAP_CLICK
  CONTACT_SUBMIT
  AD_IMPRESSION
  AD_CLICK
}

model AnalyticsEvent {
  id                   String                 @id @default(uuid())
  eventType            EventType
  resourceId           String
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime               @default(now())

  @@index([eventType, resourceId])
}

model AdSlot {
  id                   String                 @id @default(uuid())
  name                 String
  location             String
  width                Int?
  height               Int?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())

  campaigns            AdCampaign[]
}

model AdCampaign {
  id                   String                 @id @default(uuid())
  slotId               String
  slot                 AdSlot                 @relation(fields: [slotId], references: [id])

  title                String
  imageUrl             String
  targetUrl            String
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean                @default(true)
  clicks               Int                    @default(0)
  impressions          Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Post {
  id                   String                 @id @default(uuid())
  professionalId       String
  professional         ProfessionalProfile    @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  title                String
  slug                 String                 @unique
  content              String                 @db.Text
  published            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Notification {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                 String
  title                String
  content              String
  isRead               Boolean                @default(false)
  createdAt            DateTime               @default(now())
}

// Registro de envíos de correo y WhatsApp (auditoría + depuración)
enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  SENT
  FAILED
  SKIPPED
}

model MessageLog {
  id                   String                 @id @default(uuid())
  channel              MessageChannel
  recipient            String
  template             String
  status               MessageStatus
  errorMessage         String?
  relatedUserId        String?
  createdAt            DateTime               @default(now())

  @@index([channel, status])
}

model AuditLog {
  id                   String                 @id @default(uuid())
  userId               String?
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  action               String
  resource             String
  resourceId           String?
  details              Json?
  ipAddress            String?
  createdAt            DateTime               @default(now())

  @@index([resource, resourceId])
}

// Registro de consentimiento de cookies (evidencia de cumplimiento)
model CookieConsent {
  id                   String                 @id @default(uuid())
  subjectId            String                 // userId o UUID anónimo guardado en cookie
  necessary            Boolean                @default(true)
  analytics            Boolean                @default(false)
  marketing            Boolean                @default(false)
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime               @default(now())

  @@index([subjectId])
}

// Configuración global (SEO por defecto, datos de Pago Móvil de la
// plataforma, textos de cookies, etc.) como pares clave/valor.
model SiteSettings {
  id                   String                 @id @default(uuid())
  key                  String                 @unique
  value                Json
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

// SEO editable por página estática (estilo Yoast) para rutas que no
// tienen una entidad propia (home, /medicos, /especialidades, ...).
model PageSeo {
  id                   String                 @id @default(uuid())
  path                 String                 @unique
  title                String?
  metaDescription      String?
  focusKeyword         String?
  ogImageUrl           String?
  noIndex              Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}
