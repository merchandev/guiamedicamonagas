// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cuentas y autenticación
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  role                Role      @default(USER)
  isEmailVerified     Boolean   @default(false)
  isActive            Boolean   @default(true)
  /// Baja administrativa reversible; nunca elimina pagos ni datos clínicos.
  deletedAt           DateTime?
  moderationReason    String?
  /// Eliminación definitiva (solo SUPERADMIN, sobre una cuenta ya suspendida
  /// o dada de baja): se borran los datos personales. Un médico queda como registro
  /// anónimo porque sus pagos se conservan por normativa tributaria; la
  /// cuenta de un paciente se borra. Ver AccountPurgeService.
  purgedAt            DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Suspensión temporal por una sanción (UserSanction ACCOUNT): no puede iniciar
  /// sesión hasta esta fecha. A diferencia de isActive=false, no revoca sus
  /// autorizaciones ni cancela sus citas, y vence sola.
  suspendedUntil      DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?

  /// Va en cada access token (`tv`). Subirlo invalida al instante todos los
  /// access tokens emitidos (cambio de contraseña, "cerrar todas las sesiones",
  /// reuso de refresh token), sin esperar a que expiren.
  tokenVersion        Int       @default(0)

  /// Versión vigente de los Términos y de la Política de privacidad que el
  /// usuario aceptó y cuándo. La evidencia completa de cada aceptación (todos
  /// los documentos, versiones, fecha, IP y navegador) está en LegalAcceptance.
  termsVersionAccepted   String?
  privacyVersionAccepted String?
  legalAcceptedAt        DateTime?

  /// Tipos de aviso cuyo correo el usuario apagó (solo los opcionales de
  /// notifications/notification-types.ts); el aviso en la campana sigue llegando.
  notificationEmailOptOut String[] @default([])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  professionalProfile ProfessionalProfile?
  patientProfile      PatientProfile?
  organizationMemberships OrganizationMember[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  reviewedDocuments   ProfessionalDocument[] @relation("DocumentReviewer")
  reviewedPayments    Payment[]              @relation("PaymentReviewer")
  pushSubscriptions   PushSubscription[]
  grantedPatientData  PatientDataGrant[]
  reviewedIdentities  PatientProfile[]       @relation("IdentityReviewer")
  patientVaultSessions PatientVaultSession[]
  sentOrganizationInvitations     OrganizationInvitation[] @relation("OrganizationInvitationSender")
  acceptedOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationAcceptor")
  legalAcceptances    LegalAcceptance[]
  legalRequests       LegalRequest[]         @relation("LegalRequestRequester")
  resolvedLegalRequests LegalRequest[]       @relation("LegalRequestResolver")
  moderatedReviews    Review[]               @relation("ReviewModerator")
  moderatedReviewReplies ReviewReply[]       @relation("ReviewReplyModerator")
  reviewReports       ReviewReport[]         @relation("ReviewReporter")
  resolvedReviewReports ReviewReport[]       @relation("ReviewReportResolver")
  sanctions           UserSanction[]         @relation("UserSanctions")
  sanctionsCreated    UserSanction[]         @relation("SanctionsCreated")
  sanctionsLifted     UserSanction[]         @relation("SanctionsLifted")
  contactRequests     ContactMessage[]       @relation("ContactRequests")

  @@index([role])
}

enum Role {
  USER
  PROFESSIONAL
  ORGANIZATION
  ADMIN
  SUPERADMIN
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MFA_LOGIN
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique
  type      VerificationTokenType
  /// Solo MFA_LOGIN: hash del código de 6 dígitos enviado por correo.
  codeHash  String?
  attempts  Int                   @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Geografía de Venezuela como datos (no constantes): Estado → Municipio →
// Parroquia. Se lanza con Monagas, pero cualquier estado se habilita
// cargando sus municipios, sin refactorizar el sistema.
// ---------------------------------------------------------------------------

model State {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  municipalities Municipality[]
}

model Municipality {
  id        String   @id @default(uuid())
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  createdAt DateTime @default(now())

  parishes Parish[]

  @@unique([stateId, slug])
  @@unique([stateId, name])
}

model Parish {
  id             String       @id @default(uuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  createdAt      DateTime     @default(now())

  @@unique([municipalityId, slug])
}

// ---------------------------------------------------------------------------
// Perfil profesional y verificación legal (Ley de Ejercicio de la Medicina,
// MPPS/SACS, Colegio de Médicos, INPREMEDICO complementario)
// ---------------------------------------------------------------------------

model ProfessionalProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug      String  @unique
  firstName String
  lastName  String
  photoUrl  String?
  bio       String?
  /// Video de presentación en YouTube (plan Marca Médica): solo el ID de 11
  /// caracteres, nunca una URL libre. La ficha lo incrusta desde
  /// youtube-nocookie.com y solo mientras el plan sea Agencia; si baja de
  /// plan se conserva, oculto, por si vuelve a subir.
  presentationVideoId String?

  /// Código público del médico («GM-7KQ4M9»): lo comparte (texto o QR) para
  /// que el paciente lo encuentre en el buscador o abra su ficha. No es un
  /// secreto; es estable aunque cambie el slug. Se asigna al crear el perfil.
  publicCode String? @unique
  /// Nombre y apellido en minúsculas y sin tildes, solo para el buscador
  /// («perez» encuentra a «Pérez»). El buscador nunca usa cédula, RIF,
  /// correo ni dirección.
  searchName String  @default("")

  // Avales legales y gremiales (obligatorios para publicarse en el directorio)
  mppsNumber          String?
  colmedMonagasNumber String?
  inpremedicoNumber   String?
  cedula              String?
  rif                 String?

  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedAt         DateTime?
  isPublished        Boolean            @default(false)
  isSpecialist       Boolean            @default(false)
  /// Plan vigente (pagado o la prueba). FREE = sin plan: el perfil no se
  /// muestra en el directorio (ver publication-rules.ts).
  planTier           PlanTier           @default(FREE)
  /// Prueba gratuita del plan Plus, una sola vez: empieza sola la primera vez
  /// que el perfil puede publicarse con el 100% de los documentos aprobados.
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  /// Avisos de la prueba ya enviados. CLOSED: terminó o se pagó un plan (ya no
  /// hay prueba para este médico).
  trialNotice        TrialNotice        @default(NONE)
  /// 0–100, recalculado al editar el perfil.
  profileCompleteness Int               @default(0)
  /// Orden del directorio = completitud + impulso acotado por plan (máx. +15).
  /// Un plan pago no puede superar a un perfil gratuito mucho más completo.
  directoryScore      Int               @default(0)
  /// Promedio y cantidad de valoraciones publicadas, recalculados en la misma
  /// transacción de cada cambio (ver reviews/review-rating.ts). No cambian el
  /// orden del directorio.
  ratingAverage       Float?
  ratingCount         Int               @default(0)

  phone        String?
  whatsapp     String?
  municipality String?
  address      String?
  latitude     Float?
  longitude    Float?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialties   ProfessionalSpecialty[]
  documents     ProfessionalDocument[]
  subscriptions Subscription[]
  posts         Post[]
  messages      ContactMessage[]
  locations     ProfessionalLocation[]
  socialLinks   ProfessionalSocialLink[]
  schedule      Schedule?
  appointments  Appointment[]
  clinicalNotes ClinicalNote[]
  financeRecords FinanceRecord[]
  registrations ProfessionalRegistration[]
  dataGrants    PatientDataGrant[]
  walkInPatients PatientProfile[]
  registeredPatients ProfessionalPatient[]
  organizations OrganizationProfessional[]
  reviews       Review[]
  searchAppearances SearchAppearance[]
  prescriptionPad PrescriptionPad?
  prescriptions   Prescription[]

  @@index([verificationStatus, isPublished])
  @@index([municipality])
  @@index([planTier])
  @@index([directoryScore])
  @@index([trialNotice, trialEndsAt])
}

/// Avisos de la prueba gratuita de Plus: 3 días antes, 1 día antes y al vencer.
enum TrialNotice {
  NONE
  ENDS_IN_3_DAYS
  ENDS_IN_1_DAY
  CLOSED
}

enum RegistrationType {
  MPPS_SACS           // Registro del título ante el MPPS (SACS)
  COLEGIO_MEDICOS     // Matrícula en un Colegio de Médicos (por estado)
  INPREMEDICO         // Complementario / histórico
  ESPECIALIDAD        // Credencial de especialidad
  OTRO
}

/**
 * Registros profesionales por emisor y jurisdicción. Un mismo médico puede
 * estar matriculado en varios Colegios (Monagas, Anzoátegui, Miranda...).
 * Sustituye progresivamente a mppsNumber / colmedMonagasNumber /
 * inpremedicoNumber, que se mantienen sincronizados por compatibilidad.
 */
model ProfessionalRegistration {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  type         RegistrationType
  issuer       String    // "MPPS", "Colegio de Médicos del Estado Monagas"
  jurisdiction String?   // "Nacional", "Monagas", "Anzoátegui"
  number       String
  issueDate    DateTime?
  expiryDate   DateTime?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, type, issuer])
}

/**
 * Sedes adicionales de consulta, disponibles desde el plan Plus.
 */
model ProfessionalLocation {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  name         String
  address      String
  municipality String?
  phone        String?
  whatsapp     String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
}

// Instagram/Facebook/TikTok (redes) y Web, disponibles según el plan:
// Plus = hasta 2 redes; Premium, Agencia y Organización = las 3 redes + web.
enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WEBSITE
}

model ProfessionalSocialLink {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())

  @@unique([professionalId, platform])
}

enum PlanTier {
  FREE
  PROFESSIONAL
  PROFESSIONAL_PLUS
  PREMIUM
  // Agencia: todo lo de Premium + videos en colaboración con la Guía y
  // video de presentación incrustado en la ficha.
  AGENCY
  ORGANIZATION
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

// Catálogo de documentos exigidos por la ley venezolana para habilitar
// médicos en el directorio. Cada tipo tiene su propia validación de admin.
enum DocumentType {
  TITULO_MEDICO // Título de Médico Cirujano (sellado Registro Principal)
  REGISTRO_MPPS_SACS // Constancia de Registro de Título ante el MPPS (SACS)
  ARTICULO_8 // Constancia de cumplimiento del Art. 8 (rural/internado)
  MATRICULA_COLEGIO_MONAGAS // N° de Matrícula, Colegio de Médicos de Monagas
  INPREMEDICO // Registro ante la FMV
  SOLVENCIA_DEONTOLOGICA // Vigencia anual, Colegio de Médicos de Monagas
  TITULO_POSTGRADO // Solo especialistas
  CREDENCIAL_ESPECIALIDAD // Reconocimiento de especialidad, Colegio de Médicos de Monagas
  CEDULA_IDENTIDAD
  RIF
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ProfessionalDocument {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  type             DocumentType
  fileKey          String // clave privada en almacenamiento (S3/MinIO)
  originalFileName String
  mimeType         String
  fileSizeBytes    Int

  status    DocumentStatus @default(PENDING)
  issuedAt  DateTime? // fecha de emisión del documento (p.ej. solvencia)
  expiresAt DateTime? // solvencia deontológica vence anualmente

  reviewedById String?
  reviewedBy   User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId, type])
  @@index([status])
}

model Specialty {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professionals ProfessionalSpecialty[]
}

model ProfessionalSpecialty {
  professionalId String
  specialtyId    String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty      Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([professionalId, specialtyId])
}

// ---------------------------------------------------------------------------
// Organizaciones (farmacias, laboratorios, clínicas)
// ---------------------------------------------------------------------------

model Organization {
  id          String           @id @default(uuid())
  type        OrganizationType
  slug        String           @unique
  name        String
  description String?
  logoUrl     String?
  rif         String?
  isPublished Boolean          @default(true)

  /// Las creadas por un administrador nacen VERIFIED; las que se registran
  /// solas nacen PENDING y no se publican hasta que un admin las apruebe.
  verificationStatus VerificationStatus @default(VERIFIED)
  rejectionReason    String?
  verifiedAt         DateTime?
  planTier           PlanTier           @default(FREE)

  /// Listas simples editables por la propia organización.
  services       Json? // string[]
  insurers       Json? // string[] — aseguradoras aceptadas
  paymentMethods Json? // string[] — "Pago Móvil", "Efectivo", "Zelle"...
  openingHours   String?

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations     OrganizationLocation[]
  socialLinks   OrganizationSocialLink[]
  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  professionals OrganizationProfessional[]
  subscriptions Subscription[]

  @@index([verificationStatus, isPublished])
}

enum OrganizationType {
  PHARMACY
  LABORATORY
  CLINIC
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  EDITOR
}

model OrganizationMember {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(EDITOR)
  createdAt      DateTime               @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Invitación a formar parte del equipo de una organización. El rol global de
/// la cuenta (User.role) no cambia: la pertenencia es OrganizationMember. Solo
/// se guarda el hash del token; vence a las 72 h y sirve una sola vez.
model OrganizationInvitation {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Correo invitado (en minúsculas): solo esa cuenta puede aceptarla.
  email          String
  role           OrganizationMemberRole
  tokenHash      String                 @unique
  invitedById    String?
  invitedBy      User?                  @relation("OrganizationInvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?                  @relation("OrganizationInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@index([email])
}

enum AffiliationStatus {
  PENDING  // la organización invitó; el médico aún no acepta
  ACCEPTED // visible públicamente en ambos perfiles
}

/// Médicos asociados a una clínica/laboratorio. La organización invita y el
/// médico acepta: nadie aparece vinculado a una institución sin su visto bueno.
model OrganizationProfessional {
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  status         AffiliationStatus   @default(PENDING)
  createdAt      DateTime            @default(now())
  respondedAt    DateTime?

  @@id([organizationId, professionalId])
  @@index([professionalId, status])
}

model OrganizationLocation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name          String
  address       String
  municipality  String?
  phone         String?
  whatsapp      String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrganizationSocialLink {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())

  @@unique([organizationId, platform])
}

// ---------------------------------------------------------------------------
// Suscripciones y pagos (Pago Móvil, verificación manual por admin)
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id           String       @id @default(uuid())
  tier         PlanTier     @unique
  name         String
  description  String?
  /**
   * Precio de referencia en USD; el monto a pagar en Bs se calcula con la tasa vigente al momento de suscribirse.
   */
  priceUsd     Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle
  /**
   * Lista de beneficios a mostrar en la página de precios.
   */
  features     Json?
  /**
   * Sedes totales permitidas (principal + adicionales).
   */
  maxLocations Int          @default(1)
  /**
   * Publicaciones activas permitidas; null = ilimitadas.
   */
  postsLimit   Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Pertenece a un profesional O a una organización (exactamente uno de los
/// dos; lo garantiza un CHECK en la migración).
model Subscription {
  id             String               @id @default(uuid())
  professionalId String?
  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  installments SubscriptionInstallment[]

  @@index([professionalId, status])
  @@index([organizationId, status])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

model SubscriptionInstallment {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Monto esperado en Bs, fijado al crear la cuota.
  amountBs  Decimal           @db.Decimal(12, 2)
  dueDate   DateTime
  status    InstallmentStatus @default(PENDING)

  // Evidencia histórica del cálculo USD → Bs (no depender solo del comprobante).
  priceUsd       Decimal?  @db.Decimal(10, 2)
  bcvRate        Decimal?  @db.Decimal(14, 4)
  rateSource     String?   // "BCV" | "MANUAL"
  rateEffectiveDate String? // fecha valor publicada por el BCV
  rateCapturedAt DateTime?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payments Payment[]
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model Payment {
  id            String                  @id @default(uuid())
  installmentId String
  installment   SubscriptionInstallment @relation(fields: [installmentId], references: [id])

  /// Monto reportado/recibido en Bs (el esperado vive en la cuota).
  amountBs Decimal       @db.Decimal(12, 2)
  method   PaymentMethod @default(PAGO_MOVIL)

  // Datos del reporte de Pago Móvil hechos por el profesional
  senderBankCode  String?
  senderBankName  String?
  senderPhone     String?
  referenceNumber String?
  paidAt          DateTime?
  receiptFileKey  String?

  status       PaymentStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([senderBankCode, referenceNumber])
}

/// Catálogo de bancos/instituciones (antes fijo en el frontend). Se
/// administra desde el panel: fusiones, cierres o bancos nuevos no requieren
/// un despliegue.
model FinancialInstitution {
  id                String   @id @default(uuid())
  code              String   @unique // código SUDEBAN de 4 dígitos
  name              String
  supportsPagoMovil Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PaymentMethod {
  PAGO_MOVIL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REJECTED
}

// ---------------------------------------------------------------------------
// Contacto, notificaciones, analítica y publicidad
// ---------------------------------------------------------------------------

model ContactMessage {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  senderName  String
  senderEmail String
  senderPhone String?
  content     String
  isRead      Boolean  @default(false)
  ipAddress   String?
  createdAt   DateTime @default(now())

  // ─── «Quiero que me contacte» (paciente con sesión) ─────────────────────
  // Null en los mensajes del formulario sin cuenta. Los datos que el
  // paciente eligió compartir van en las columnas sender*; al retirarlo o al
  // vencer (30 días) se borran y solo queda el registro del pedido.
  patientUserId    String?
  patientUser      User?                 @relation("ContactRequests", fields: [patientUserId], references: [id], onDelete: SetNull)
  requestStatus    ContactRequestStatus?
  /// PHONE, WHATSAPP o EMAIL: cómo prefiere que lo contacten.
  preferredChannel String?
  /// Horario en que prefiere que lo llamen («en las mañanas»).
  preferredTime    String?
  /// La cédula del paciente estaba aprobada al enviarlo.
  identityVerified Boolean               @default(false)
  /// Versión del texto que aceptó al enviarlo (CONTACT_REQUEST_CONSENT_VERSION).
  consentVersion   String?
  expiresAt        DateTime?
  statusChangedAt  DateTime?

  @@index([professionalId, createdAt])
  @@index([patientUserId, createdAt])
  @@index([requestStatus, expiresAt])
}

enum ContactRequestStatus {
  OPEN      // el médico aún no lo atendió
  CONTACTED // el médico lo marcó como contactado
  CLOSED    // el médico lo cerró
  WITHDRAWN // el paciente lo retiró: se borraron los datos compartidos
  EXPIRED   // venció a los 30 días: se borraron los datos compartidos
}

enum EventType {
  PROFILE_VIEW
  WHATSAPP_CLICK
  PHONE_CLICK
  WEBSITE_CLICK
  SOCIAL_LINK_CLICK
  MAP_CLICK
  CONTACT_SUBMIT
  AD_IMPRESSION
  AD_CLICK
}

/// Solo se registra con consentimiento de analítica del visitante, y sin IP
/// ni user-agent: un conteo anónimo por perfil y tipo de evento.
model AnalyticsEvent {
  id         String    @id @default(uuid())
  eventType  EventType
  resourceId String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([eventType, resourceId])
}

model AdSlot {
  id        String   @id @default(uuid())
  name      String
  location  String
  width     Int?
  height    Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  campaigns AdCampaign[]
}

model AdCampaign {
  id     String @id @default(uuid())
  slotId String
  slot   AdSlot @relation(fields: [slotId], references: [id])

  title       String
  imageUrl    String
  targetUrl   String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  title     String
  slug      String   @unique
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Aviso interno (la campana del sitio). Nunca lleva datos de salud ni
/// identidades que quien lo recibe no pueda ver: lo mismo que sus correos.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  content   String
  /// Ruta interna del sitio a la que lleva («/dashboard/citas»); nunca una URL externa.
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// Registro de envíos de correo y WhatsApp (auditoría + depuración)
enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageStatus {
  SENT
  FAILED
  SKIPPED
}

model MessageLog {
  id            String         @id @default(uuid())
  channel       MessageChannel
  recipient     String
  template      String
  status        MessageStatus
  errorMessage  String?
  relatedUserId String?
  createdAt     DateTime       @default(now())

  @@index([channel, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
}

/// Textos legales que se aceptan uno por uno (ver common/legal-versions.ts).
enum LegalDocument {
  TERMS                  // Términos y condiciones
  PRIVACY                // Política de privacidad
  PROFESSIONAL_TERMS     // Condiciones para profesionales
  PATIENT_HEALTH_CONSENT // Consentimiento del paciente para tratar sus datos de salud
  AGE_DECLARATION        // Declaración de mayoría de edad (pacientes)
}

/// Evidencia de cada aceptación: quién, qué documento, qué versión, cuándo y
/// desde dónde. Solo se agregan filas; nunca se editan. El texto de cada
/// versión queda en el historial del repositorio.
model LegalAcceptance {
  id         String        @id @default(uuid())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  document   LegalDocument
  version    String
  /// REGISTER (al crear la cuenta) o UPDATE (al aceptar una versión nueva).
  context    String
  acceptedAt DateTime      @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([userId, document])
}

enum LegalRequestCategory {
  PRIVACY_RIGHTS        // acceso, copia, rectificación u oposición
  ACCOUNT_DELETION      // cierre y eliminación de la cuenta
  UNAUTHORIZED_ACCESS   // acceso indebido a datos
  FALSE_IDENTITY        // identidad falsa o suplantación
  FALSE_CREDENTIAL      // título o credencial falsa
  SUSPENDED_PROFESSIONAL
  MISLEADING_CONTENT    // publicidad o contenido engañoso
  SECURITY              // vulnerabilidad o incidente
  BILLING               // cobros, pagos y reembolsos
  INTELLECTUAL_PROPERTY
  AUTHORITY_REQUEST     // requerimiento de una autoridad
  REVIEW_ABUSE          // valoración abusiva o falsa
  OTHER
}

enum LegalRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

/// Canal de reclamos, denuncias y solicitudes legales (/reclamos). El ticket
/// se entrega al solicitante; cada cambio de estado queda en la auditoría.
model LegalRequest {
  id             String               @id @default(uuid())
  ticket         String               @unique
  category       LegalRequestCategory
  status         LegalRequestStatus   @default(OPEN)
  requesterName  String
  requesterEmail String
  requesterPhone String?
  userId         String?
  user           User?                @relation("LegalRequestRequester", fields: [userId], references: [id], onDelete: SetNull)
  /// Perfil, página o recurso al que se refiere (opcional).
  subjectUrl     String?
  description    String
  resolution     String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?                @relation("LegalRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  ipAddress      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([category])
}

// Registro de consentimiento de cookies (evidencia de cumplimiento)
model CookieConsent {
  id        String   @id @default(uuid())
  subjectId String // userId o UUID anónimo guardado en cookie
  necessary Boolean  @default(true)
  analytics Boolean  @default(false)
  marketing Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([subjectId])
}

// Configuración global (SEO por defecto, datos de Pago Móvil de la
// plataforma, textos de cookies, etc.) como pares clave/valor.
model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SEO editable por página estática (estilo Yoast) para rutas que no
// tienen una entidad propia (home, /medicos, /especialidades, ...).
model PageSeo {
  id              String   @id @default(uuid())
  path            String   @unique
  title           String?
  metaDescription String?
  focusKeyword    String?
  ogImageUrl      String?
  noIndex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AGENDA Y CITAS
// ---------------------------------------------------------------------------

/**
 * Disponibilidad semanal del médico.
 * Un médico tiene exactamente un Schedule; los slots se calculan
 * en tiempo de ejecución a partir de los bloques + excepciones.
 */
model Schedule {
  id             String              @id @default(uuid())
  professionalId String              @unique
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  /// Duración de cada cita en minutos (por defecto 30 min)
  slotDurationMinutes Int @default(30)

  /// Tiempo de buffer entre citas en minutos (limpieza, notas)
  bufferMinutes Int @default(0)

  /// Máximo de citas por día; null = sin límite
  maxDailyAppointments Int?

  /// Si el médico acepta citas sin necesidad de confirmarlas manualmente
  autoConfirm Boolean @default(false)

  /// Hasta cuántos días adelante puede reservar un paciente.
  bookingWindowDays Int @default(60)

  /// Antelación mínima (minutos) con la que un paciente puede reservar o
  /// reprogramar. No aplica a las citas que carga o mueve el propio médico.
  minNoticeMinutes Int @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks     ScheduleBlock[]
  exceptions ScheduleException[]
}

/**
 * Bloque semanal recurrente de disponibilidad.
 * Ejemplo: Lunes 08:00–12:00, Lunes 14:00–18:00.
 */
model ScheduleBlock {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  dayOfWeek Int
  startTime String  // "08:00"
  endTime   String  // "12:00"

  @@index([scheduleId, dayOfWeek])
}

/**
 * Excepción puntual en la agenda (puede haber varias el mismo día):
 * - isBlocked sin horas: día bloqueado (vacaciones, guardia);
 * - isBlocked con horas: solo ese tramo bloqueado (desde el calendario);
 * - no bloqueado con horas: horario especial ese día en lugar del habitual.
 */
model ScheduleException {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  date      DateTime // fecha específica (solo se usa la parte de la fecha)
  isBlocked Boolean  @default(true)
  startTime String?  // inicio del tramo (bloqueado o del horario especial)
  endTime   String?  // fin del tramo
  reason    String?  // "Vacaciones", "Congreso médico"

  @@index([scheduleId, date])
}

// ---------------------------------------------------------------------------
// FICHAS DE PACIENTE (pseudonimizadas)
// ---------------------------------------------------------------------------

/**
 * Perfil del paciente. El `patientCode` es el único identificador
 * que ve el médico en su agenda — nunca el nombre ni la cédula.
 *
 * SEC-05 — cifrado en capa de aplicación (AES-256-GCM, claves fuera de
 * PostgreSQL, ver src/crypto/field-encryption.service.ts):
 *   - cedulaEnc / phoneEnc: valor cifrado.
 *   - cedulaLookup / phoneLookup: HMAC-SHA256 del valor normalizado, con
 *     una clave distinta. Permite unicidad y búsqueda exacta sin guardar el
 *     dato en claro ni un hash simple enumerable.
 *   - healthDataEnc: TODOS los datos de salud y contacto de emergencia en un
 *     único JSON cifrado (fecha de nacimiento, sexo, grupo sanguíneo,
 *     alergias, condición, medicamentos, médicos tratantes, contactos).
 * Un volcado de la base de datos, sin las claves, no revela estos datos.
 *
 * El médico solo ve datos del paciente con un PatientDataGrant vigente
 * (consentimiento explícito, temporal, revocable y auditado).
 */
model PatientProfile {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Código único visible: "GMM-A4F2". Lo genera el sistema, no el paciente.
  /// Es el identificador que el médico usa en la agenda.
  patientCode String @unique

  firstName    String?
  lastName     String?
  municipality String?

  cedulaEnc    String?
  cedulaLookup String? @unique
  phoneEnc     String?
  phoneLookup  String? @unique

  healthDataEnc String?

  /// Ficha sin cuenta creada por un médico (walk-in / cita por teléfono):
  /// ese médico ya conoce los datos porque los cargó él mismo.
  createdByProfessionalId String?
  createdByProfessional   ProfessionalProfile? @relation(fields: [createdByProfessionalId], references: [id], onDelete: SetNull)

  // ─── Identidad ─────────────────────────────────────────────────────────
  photoKey       String?               // foto de perfil (clave privada en storage)
  idPhotoKey     String?               // foto de cédula/identificación (clave privada)
  identityStatus IdentityStatus @default(PENDING)
  /// Revisión administrativa de la foto de identificación. Al rechazarla se
  /// borra el archivo (minimización): el paciente sube una nueva.
  identityReviewNote   String?
  identityReviewedAt   DateTime?
  identityReviewedById String?
  identityReviewedBy   User?     @relation("IdentityReviewer", fields: [identityReviewedById], references: [id], onDelete: SetNull)

  // ─── Código para compartir con el médico (texto y QR) ────────────────────
  /// Lo genera el paciente y lo entrega a su médico para que lo registre sin
  /// revelar su identidad en público. Aleatorio (12 caracteres, ~7,9·10^17
  /// combinaciones), cifrado como la cédula: `shareCodeLookup` es el HMAC del
  /// código normalizado, para encontrarlo sin guardarlo en claro. Rotarlo
  /// invalida el anterior; los médicos que ya lo registraron conservan el vínculo.
  shareCodeEnc       String?
  shareCodeLookup    String?            @unique
  shareCodeCreatedAt DateTime?
  /// Qué verá el médico que registre al paciente con su código.
  shareScopes        PatientDataScope[] @default([IDENTITY, CONTACT, HEALTH])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  clinicalNotes  ClinicalNote[]
  dataGrants     PatientDataGrant[]
  registeredBy   ProfessionalPatient[]
  reviews        Review[]
  prescriptions  Prescription[]

  @@index([patientCode])
  @@index([identityStatus])
}

enum PatientDataScope {
  IDENTITY // nombre y apellido
  CONTACT  // teléfono y contactos/dirección de emergencia
  HEALTH   // condición, alergias, medicamentos, grupo sanguíneo, etc.
}

/**
 * Consentimiento del paciente para que UN médico vea datos concretos
 * durante un tiempo limitado. Revocable en cualquier momento. Cada lectura
 * que se apoya en un grant queda en AuditLog (PATIENT_DATA_READ).
 */
model PatientDataGrant {
  id             String              @id @default(uuid())
  patientId      String
  patient        PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  scopes         PatientDataScope[]
  reason         String?
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  grantedById    String?
  grantedBy      User?     @relation(fields: [grantedById], references: [id], onDelete: SetNull)
  /// Versión del texto de consentimiento mostrado al paciente.
  consentVersion String

  @@index([patientId, professionalId])
  @@index([professionalId, expiresAt])
}

/**
 * Paciente que un médico registró en su directorio con el código (o el QR)
 * que el paciente le entregó. El vínculo solo ubica al paciente: qué datos
 * ve el médico lo decide el PatientDataGrant, que el paciente puede revocar.
 */
model ProfessionalPatient {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())
  /// El paciente revocó el acceso de este médico. Mientras sea posterior a
  /// PatientProfile.shareCodeCreatedAt, el mismo código no vuelve a dar
  /// acceso: hace falta que el paciente genere y entregue uno nuevo.
  accessRevokedAt DateTime?

  @@unique([professionalId, patientId])
  @@index([patientId])
}

/**
 * Apertura de la «bóveda» de registros de pacientes por un administrador:
 * exige el código de seguridad (PATIENT_VAULT_CODE_HASH) además de la sesión,
 * dura 15 minutos y queda auditada. En la BD solo queda el hash del token de
 * la cookie httpOnly que la identifica.
 */
model PatientVaultSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  closedAt  DateTime?
  ipAddress String?

  @@index([userId, expiresAt])
}

enum IdentityStatus {
  PENDING  // sin revisar (incluye el caso de no haber subido nada aún)
  VERIFIED
  REJECTED
}

// ---------------------------------------------------------------------------
// CITAS
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  PENDING    // agendada, pendiente de confirmación del médico
  CONFIRMED  // médico confirmó
  COMPLETED  // consulta realizada
  CANCELLED  // cancelada (por médico o paciente)
  NO_SHOW    // paciente no se presentó
}

enum AppointmentSource {
  WEB       // agendada desde el sitio web
  WHATSAPP  // agendada via WhatsApp (manual o bot)
  APP       // futuro: app Flutter
  PHONE     // ingresada manualmente por el médico
}

enum CancelledByType {
  PATIENT
  PROFESSIONAL
}

model Appointment {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Sede donde se atiende (para médicos con múltiples consultorios)
  locationId String?
  location   ProfessionalLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  startsAt DateTime
  endsAt   DateTime
  status   AppointmentStatus @default(PENDING)

  /// Motivo de consulta escrito por el paciente al agendar
  reason String?

  /// Canal por el que fue agendada
  source AppointmentSource @default(WEB)

  /// Notas internas del médico (no visibles para el paciente)
  internalNotes String?

  // Seguimiento de notificaciones enviadas
  confirmationSentAt DateTime?
  reminderSentAt     DateTime? // recordatorio de 24h
  reminder2hSentAt   DateTime? // recordatorio de 2h

  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        CancelledByType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicalNote   ClinicalNote?
  financeRecords FinanceRecord[]
  events         AppointmentEvent[]

  @@index([professionalId, startsAt])
  @@index([patientId])
  @@index([status])
  @@index([startsAt])
}

enum AppointmentEventType {
  CREATED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentActor {
  PATIENT
  PROFESSIONAL
  SYSTEM
  ADMIN
}

/**
 * Historial de cada cita: quién hizo qué y cuándo. Solo se agregan filas, en
 * la misma transacción que el cambio. Sin texto libre: el motivo de una
 * cancelación queda en la cita.
 */
model AppointmentEvent {
  id            String               @id @default(uuid())
  appointmentId String
  appointment   Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          AppointmentEventType
  actor         AppointmentActor
  actorUserId   String?
  /// Al reprogramar: de qué inicio a cuál.
  previousStartsAt DateTime?
  newStartsAt      DateTime?
  /// El médico la puso fuera de su horario habitual.
  outsideSchedule  Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([appointmentId, createdAt])
}

// ---------------------------------------------------------------------------
// HISTORIAL CLÍNICO
// ---------------------------------------------------------------------------

/**
 * Nota clínica asociada a una cita completada.
 * Creada y visible solo por el médico que la redactó.
 * Los campos de contenido clínico se cifrarán en SEC-05.
 *
 * CLASIFICACIÓN: SECRETO
 */
model ClinicalNote {
  id            String         @id @default(uuid())
  appointmentId String         @unique
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  /// SEC-05: todo el contenido clínico (motivo, diagnóstico, tratamiento,
  /// medicamentos y notas privadas) va cifrado en un solo campo con
  /// ClinicalNoteCodec (AES-256-GCM, contexto "ClinicalNote.clinicalData").
  /// No existen columnas en claro: una nota clínica no se puede guardar sin cifrar.
  clinicalDataEnc String

  /// Fecha sugerida para próxima cita (no revela contenido clínico)
  followUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([professionalId])
}

// ---------------------------------------------------------------------------
// FINANZAS DEL MÉDICO
// ---------------------------------------------------------------------------

enum FinanceType {
  INCOME
  EXPENSE
}

/**
 * Registro de ingresos y gastos del médico (vista personal).
 * No es visible para la plataforma ni para los pacientes.
 * Los montos se registran en Bs y, opcionalmente, en USD
 * usando la tasa BCV del día (ya existe el scraper exchange-rate).
 */
model FinanceRecord {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  type        FinanceType
  category    String    // "Consulta", "Material", "Alquiler", "Impuesto"
  amountBs    Decimal   @db.Decimal(12, 2)
  /// Calculado automáticamente con la tasa BCV del día del registro
  amountUsd   Decimal?  @db.Decimal(10, 2)
  /// Tasa BCV usada para el cálculo
  bcvRateUsed Decimal?  @db.Decimal(10, 4)
  description String?
  date        DateTime

  /// Si el ingreso viene de una cita específica (auto-generado al completarla)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  receiptFileKey String?  // comprobante en MinIO (opcional)

  createdAt DateTime @default(now())

  @@index([professionalId, date])
  @@index([professionalId, type])
  @@index([appointmentId])
}

// ---------------------------------------------------------------------------
// NOTIFICACIONES PUSH WEB (VAPID)
// ---------------------------------------------------------------------------

/**
 * Suscripción a Web Push del médico.
 * Cada dispositivo/navegador que activa las notificaciones
 * genera una entrada aquí. Un médico puede tener múltiples suscripciones
 * (computadora de consultorio, laptop, teléfono).
 */
model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique // URL de push service del navegador
  p256dh    String  // clave pública de cifrado
  auth      String  // secreto de autenticación
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// VALORACIONES DE PACIENTES
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING   // en moderación: todo texto (comentario o respuesta) pasa por aquí
  PUBLISHED
  REJECTED  // no se publicó; el autor recibe el motivo y puede corregirla
  WITHDRAWN // retirada del sitio por la administración; se guarda como evidencia
}

enum ReviewBasis {
  APPOINTMENT // una cita realizada en la plataforma con ese médico
  REGISTERED  // el médico registró al paciente con su código
}

enum ReviewAuthorDisplay {
  ANONYMOUS // «Paciente verificado»
  INITIAL   // nombre e inicial del apellido («María G.»)
}

enum ReviewReportReason {
  NOT_MY_PATIENT
  HEALTH_DATA
  OFFENSIVE
  FALSE
  OTHER
}

enum ReviewReportStatus {
  OPEN
  UPHELD    // la administración le dio la razón (retiró o corrigió la valoración)
  DISMISSED
}

/**
 * Valoración de un paciente sobre un médico: 1 a 5 estrellas (CHECK en la
 * migración) y un comentario opcional. Una por paciente y médico; editarla la
 * devuelve a moderación. Solo pacientes con el registro completo, la identidad
 * verificada y una consulta verificada con ese médico (ver reviews.service.ts).
 * El público nunca ve la cédula, el código, la foto ni la fecha exacta.
 */
model Review {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  basis             ReviewBasis
  /// Mes de la consulta que la respalda («2026-09», hora de Caracas): es lo
  /// único que se publica de la fecha.
  consultationMonth String
  rating            Int
  comment           String?
  authorDisplay     ReviewAuthorDisplay @default(ANONYMOUS)
  status            ReviewStatus        @default(PENDING)
  /// Lo que el filtro automático encontró en el comentario (teléfono, correo,
  /// enlace, cédula, insulto, términos de salud): orienta a quien modera.
  flags             String[]            @default([])
  /// Versión de las reglas que el autor aceptó al enviarla.
  rulesVersion      String
  publishedAt       DateTime?

  moderatedAt    DateTime?
  moderatedById  String?
  moderatedBy    User?     @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  /// Motivo del rechazo o del retiro: lo recibe el autor.
  moderationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reply   ReviewReply?
  reports ReviewReport[]

  @@unique([professionalId, patientId])
  @@index([professionalId, status, publishedAt])
  @@index([status, updatedAt])
  @@index([patientId, createdAt])
}

/// Respuesta pública del médico a una valoración: una sola, con moderación previa.
model ReviewReply {
  id       String       @id @default(uuid())
  reviewId String       @unique
  review   Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  content  String
  status   ReviewStatus @default(PENDING)
  flags    String[]     @default([])
  publishedAt DateTime?

  moderatedAt    DateTime?
  moderatedById  String?
  moderatedBy    User?     @relation("ReviewReplyModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

/// Denuncia de una valoración (por ahora, del médico valorado): va a la cola de la administración.
model ReviewReport {
  id         String             @id @default(uuid())
  reviewId   String
  review     Review             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User               @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReviewReportReason
  details    String?
  status     ReviewReportStatus @default(OPEN)

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?     @relation("ReviewReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?

  createdAt DateTime @default(now())

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
}

enum SanctionType {
  REVIEWS // no puede escribir ni editar valoraciones ni respuestas; el resto de la cuenta sigue igual
  ACCOUNT // no puede iniciar sesión hasta la fecha (User.suspendedUntil)
}

/**
 * Sanción por lo que alguien escribió en valoraciones o respuestas: por los
 * días que elija la administración (1 a 365) o, solo la de opiniones, por
 * tiempo indefinido. Se puede levantar antes o cambiar su fin. Vence sola: la
 * API la deja de aplicar al pasar endsAt y una tarea avisa al titular.
 */
model UserSanction {
  id       String       @id @default(uuid())
  userId   String
  user     User         @relation("UserSanctions", fields: [userId], references: [id], onDelete: Cascade)
  type     SanctionType
  reason   String
  startsAt DateTime     @default(now())
  /// null = indefinida (solo REVIEWS).
  endsAt   DateTime?
  /// Valoración que la motivó (sin clave foránea: la sanción sobrevive si se borra).
  reviewId String?

  createdById String?
  createdBy   User?     @relation("SanctionsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  liftedAt    DateTime?
  liftedById  String?
  liftedBy    User?     @relation("SanctionsLifted", fields: [liftedById], references: [id], onDelete: SetNull)
  liftReason  String?
  /// Cuándo se le avisó que terminó (la tarea de cada 10 minutos).
  endNoticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([endsAt])
}

/**
 * Cuántas veces apareció un médico en los resultados del directorio, por día
 * (hora de Caracas) y por la especialidad y el municipio filtrados (vacío =
 * sin filtro). Solo conteos de visitantes que aceptaron la analítica: nunca
 * quién buscó, ni el texto que escribió, ni su IP.
 */
model SearchAppearance {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  day            DateTime            @db.Date
  specialtySlug  String              @default("")
  municipality   String              @default("")
  count          Int                 @default(0)

  @@unique([professionalId, day, specialtySlug, municipality])
}

// ---------------------------------------------------------------------------
// RÉCIPES DIGITALES
// ---------------------------------------------------------------------------

/**
 * Talonario del médico para sus récipes digitales: logo, firma y sello
 * (imágenes privadas en el almacenamiento) y los datos del establecimiento de
 * salud que la Resolución 031/2013 del MPPS (art. 6) exige impresos: nombre,
 * dirección y RIF. Nombre, cédula y N° MPPS del médico salen de su perfil
 * verificado, nunca de aquí.
 */
model PrescriptionPad {
  id             String              @id @default(uuid())
  professionalId String              @unique
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  logoKey      String?
  signatureKey String?
  sealKey      String?

  establishmentName    String?
  establishmentAddress String?
  establishmentRif     String?
  establishmentPhone   String?
  /// Lugar de emisión que se imprime («Maturín, estado Monagas»).
  city                 String?
  /// Vigencia que se propone al emitir; el médico la cambia en cada récipe.
  defaultValidityDays  Int     @default(30)
  /// Correlativo del médico: número del último récipe emitido.
  lastNumber           Int     @default(0)

  /// Condiciones de uso del récipe digital que aceptó el médico (PRESCRIPTION_RULES_VERSION).
  rulesVersion    String?
  rulesAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrescriptionStatus {
  ISSUED
  ANNULLED
}

/**
 * Récipe emitido. No se edita: para corregirlo, el médico lo anula y emite
 * otro. Todo su contenido (médico, establecimiento, paciente, medicamentos e
 * indicaciones) va cifrado en `contentEnc`; el código de verificación, solo
 * como HMAC (para buscarlo) y cifrado (para mostrarlo).
 */
model Prescription {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  number         Int

  codeLookup String @unique
  codeEnc    String

  /// Paciente con cuenta que lo tiene en «Mis récipes»: se lo entregó el médico
  /// desde su directorio o lo agregó él con el código.
  patientId   String?
  patient     PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  deliveredAt DateTime?
  /// HMAC de la cédula impresa (la del paciente o la de su representante): solo
  /// esa persona puede agregarlo a su cuenta con el código.
  patientCedulaLookup String?

  contentEnc  String
  /// SHA-256 del contenido y de sus datos de emisión; se imprime abreviado como huella.
  contentHash String

  /// Imágenes con las que se emitió: no cambian si el médico las reemplaza después.
  logoKey      String?
  signatureKey String?
  sealKey      String?

  issuedAt    DateTime           @default(now())
  expiresAt   DateTime
  status      PrescriptionStatus @default(ISSUED)
  annulledAt  DateTime?
  /// Cifrado: puede nombrar un medicamento o una dosis.
  annulReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, number])
  @@index([professionalId, issuedAt])
  @@index([patientId, issuedAt])
}

/**
 * Bandeja de la sincronización en tiempo real. La llenan disparadores de la
 * base (ver la migración `20261010120000_realtime_sync`) en la misma
 * transacción de cada cambio, venga de la web, de la app, de la administración
 * o de una tarea programada. Solo guarda qué fila cambió y los identificadores
 * que dicen a quién le importa, nunca su contenido. La API lo reparte por su
 * canal en tiempo real y borra lo que tiene más de un día.
 */
model RealtimeEvent {
  id           BigInt    @id @default(autoincrement())
  /// Tabla de origen («Appointment», «Notification»…).
  source       String
  /// INSERT, UPDATE o DELETE.
  op           String
  rowId        String?
  /// Identificadores de la fila que dicen a quién avisar (profesional, paciente, usuario…).
  keys         Json      @default("{}")
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, id])
  @@index([createdAt])
}
