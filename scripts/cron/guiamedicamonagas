# Tareas programadas de Guía Médica Monagas — se instala en /etc/cron.d/guiamedicamonagas
# (ver docs/operations/respaldos-y-restauracion.md). Hora del servidor: UTC (Caracas = UTC-4).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Respaldo cifrado de la base de datos: todos los días a las 03:30 de Caracas.
30 7 * * *  root  /opt/guiamedicamonagas/scripts/backup.sh >> /var/log/guiamedicamonagas/backup.log 2>&1
# Base de datos + archivos (fotos, documentos, comprobantes): domingos a las 04:00 de Caracas.
0 8 * * 0   root  /opt/guiamedicamonagas/scripts/backup.sh --with-files --label weekly >> /var/log/guiamedicamonagas/backup.log 2>&1
# Prueba de restauración del último respaldo: lunes a las 04:30 de Caracas.
30 8 * * 1  root  /opt/guiamedicamonagas/scripts/restore-test.sh >> /var/log/guiamedicamonagas/restore-test.log 2>&1
# Prueba de restauración desde la COPIA EXTERNA: primer lunes de cada mes a las 05:30 de Caracas
# (se omite mientras no haya copia externa configurada). El día va en la orden porque cron
# une con «o» el día del mes y el de la semana.
30 9 * * 1  root  [ "$(date +\%d)" -le 7 ] && /opt/guiamedicamonagas/scripts/restore-test.sh --from-remote --if-configured >> /var/log/guiamedicamonagas/restore-test.log 2>&1
# Monitoreo cada 5 minutos (scripts/healthcheck.sh; canales en /root/.config/guiamedicamonagas/alerts.env).
*/5 * * * * root  /opt/guiamedicamonagas/scripts/healthcheck.sh
